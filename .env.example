# Copy to .env and fill in. Never commit .env.
KONDIS_SECRET_KEY=change-me-to-a-long-random-string
KONDIS_DEBUG=0
KONDIS_ALLOWED_HOSTS=pt.example.com
KONDIS_CSRF_TRUSTED_ORIGINS=https://pt.example.com
# Used for the client links you share. Leave empty to use the request host.
KONDIS_BASE_URL=https://pt.example.com
# SQLite by default. For PostgreSQL: postgres://kondis:password@db:5432/kondis
KONDIS_DATABASE_URL=sqlite:////app/data/kondis.sqlite3
KONDIS_LANGUAGE=tr
KONDIS_TIME_ZONE=Europe/Istanbul
# Set to 0 only if you serve plain HTTP on a private network.
KONDIS_SECURE_COOKIES=1

# Kondis Cloud (hosted) only
# KONDIS_HOSTED=1
# KONDIS_TRIAL_DAYS=7
# KONDIS_PRICE_MONTHLY=499
# KONDIS_PRICE_YEARLY=4.990
# KONDIS_PAY_MONTHLY_URL=
# KONDIS_PAY_YEARLY_URL=
# KONDIS_SUPPORT_WHATSAPP=905xxxxxxxxx
